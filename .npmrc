# Docker/Alpine (musl) and Windows must resolve the same optional native packages.
# Without this, a Windows-generated lockfile can fail `pnpm install --frozen-lockfile`
# on the VPS node:22-alpine image.
package-manager-strict=false
package-manager-strict-version=false
supportedArchitectures.os[]=linux
supportedArchitectures.os[]=darwin
supportedArchitectures.os[]=win32
supportedArchitectures.cpu[]=x64
supportedArchitectures.cpu[]=arm64
supportedArchitectures.libc[]=glibc
supportedArchitectures.libc[]=musl
