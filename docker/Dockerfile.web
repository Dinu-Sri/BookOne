# BookOne v2 — Production web (ERP only — no Chromium / E2E)
#
# GitHub Actions "Docker web image" builds this file and pushes
# ghcr.io/dinu-sri/bookone-web. Portainer only pulls that tag.
# "Production Check" is a separate pnpm install/lint/build/test job.
# Use Debian slim so install matches that proven Linux lockfile, not Alpine musl.
#
# Full apps/ + packages/ copy matches CI checkout (765dbe5). Manifest-only
# copy broke after Wave 1b removed apps/e2e-runner from the lockfile.
FROM node:22-bookworm-slim AS base
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# Same install path that deployed for months.
RUN npm install -g pnpm@9

FROM base AS deps
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV CI=false
ENV NPM_CONFIG_UPDATE_NOTIFIER=false
ENV PNPM_NETWORK_CONCURRENCY=4
ENV NODE_OPTIONS=--max-old-space-size=2048

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json .npmrc ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY docker/entrypoint.sh ./docker/entrypoint.sh

# fumadocs-mdx runs in the builder stage (704099b). Low concurrency for 8GB VPS.
RUN pnpm --version \
 && pnpm install --ignore-scripts --network-concurrency=4 \
 || pnpm install --ignore-scripts --network-concurrency=1 --reporter=append-only

FROM base AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app ./

ARG BUILD_DATE=0
RUN echo "Build: $BUILD_DATE" && rm -rf apps/web/.next apps/web/.turbo

RUN pnpm --dir apps/web exec fumadocs-mdx
RUN pnpm --dir apps/web build

FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN groupadd --system --gid 1001 nodejs \
 && useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs /app ./

RUN mkdir -p /app/.cache /app/.next /app/.pnpm-store \
 && chown -R nextjs:nodejs /app/.cache /app/.next /app/.pnpm-store

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER nextjs

EXPOSE 3100
ENV PORT=3100
ENV HOSTNAME="0.0.0.0"

ENTRYPOINT ["/entrypoint.sh"]
