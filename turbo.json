{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "AUTH_SECRET",
    "AUTH_URL",
    "GITHUB_ACTIONS",
    "DB01_REQUIRE_POSTGRES",
    "CI",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_BUCKET"
  ],
  "tasks": {
    "build": {
      "outputs": [".next/**", "dist/**"],
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "AUTH_SECRET",
        "AUTH_URL",
        "S3_ENDPOINT",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "AUTH_SECRET",
        "GITHUB_ACTIONS",
        "DB01_REQUIRE_POSTGRES",
        "CI"
      ]
    },
    "db:migrate": {},
    "db:seed": {},
    "db:studio": {},
    "clean": {
      "cache": false
    }
  }
}
